{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/contact.update.partial",
  "$defs": {
    "contact.update.partial": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": { "type": "string", "const": "add" },
              "path": { "type": "string", "const": "/status" },
              "value": { "$ref": "#/$defs/contactStatus.create" }
            },
            "required": ["op", "path", "value"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": { "type": "string", "const": "replace" },
              "path": { "type": "string", "const": "/status" },
              "value": {
                "type": "array",
                "items": { "$ref": "#/$defs/contactStatus.create" }
              }
            },
            "required": ["op", "path", "value"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": { "type": "string", "const": "remove" },
              "path": { "type": "string", "const": "/status" }
            },
            "required": ["op", "path"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": { "type": "string", "const": "replace" },
              "path": { "type": "string", "const": "/status" },
              "match": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": { "enum": ["@type", "label", "reason"] }
              },
              "value": { "$ref": "#/$defs/contactStatus.create" }
            },
            "required": ["op", "path", "match", "value"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": { "type": "string", "const": "remove" },
              "path": { "type": "string", "const": "/status" },
              "match": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": { "enum": ["@type", "label", "reason"] }
              }
            },
            "required": ["op", "path", "match"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": { "type": "string", "enum": ["add", "replace"] },
              "path": { "type": "string", "const": "/contactInfo" },
              "value": { "$ref": "#/$defs/Card" }
            },
            "required": ["op", "path", "value"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": { "type": "string", "enum": ["add", "replace"] },
              "path": { "type": "string", "const": "/authInfo" },
              "value": { "$ref": "#/$defs/authInfo.create" }
            },
            "required": ["op", "path", "value"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": { "type": "string", "const": "remove" },
              "path": { "type": "string", "const": "/authInfo" }
            },
            "required": ["op", "path"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": { "type": "string", "enum": ["add", "replace"] },
              "path": { "type": "string", "const": "/disclose" },
              "value": { "$ref": "#/$defs/disclose.read" }
            },
            "required": ["op", "path", "value"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": { "type": "string", "const": "remove" },
              "path": { "type": "string", "const": "/disclose" }
            },
            "required": ["op", "path"],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    }
  }
}
