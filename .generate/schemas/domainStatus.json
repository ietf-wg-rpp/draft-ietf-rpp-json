{
  "$defs": {
    "domainStatus": {
      "type": "object",
      "properties": {
        "@type": { "type": "string", "const": "domainStatus" },
        "label": {
          "type": "string",
          "enum": [
            "clientDeleteProhibited",
            "serverDeleteProhibited",
            "clientHold",
            "serverHold",
            "clientRenewProhibited",
            "serverRenewProhibited",
            "clientTransferProhibited",
            "serverTransferProhibited",
            "clientUpdateProhibited",
            "serverUpdateProhibited",
            "inactive",
            "ok",
            "pendingCreate",
            "pendingDelete",
            "pendingRenew",
            "pendingTransfer",
            "pendingUpdate",
            "rgpAddPeriod",
            "rgpAutoRenewPeriod",
            "rgpRenewPeriod",
            "rgpTransferPeriod",
            "rgpRedemptionPeriod",
            "rgpPendingRestore",
            "rgpPendingDelete"
          ]
        },
        "reason": { "type": "string" },
        "due": { "type": "string", "format": "date-time" }
      },
      "required": ["@type", "label"]
    }
  }
}
