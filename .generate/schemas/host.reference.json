{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/host.reference",
  "$defs": {
    "host.reference": {
      "type": "object",
      "properties": {
        "@type": { "type": "string", "const": "host" },
        "hostName": { "type": "string", "format": "hostname" }
      },
      "required": ["@type", "hostName"]
    }
  }
}
