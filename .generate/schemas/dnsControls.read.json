{
  "$defs": {
    "dnsControls.read": {
      "type": "object",
      "properties": {
        "@type": { "type": "string", "const": "dnsControls", "readOnly": true },
        "ttl": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 },
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "maxSigLifetime": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 },
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" }
        }
      },
      "required": ["@type"]
    }
  }
}
