{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/discovery.read",
  "$defs": {
    "discovery.read": {
      "type": "object",
      "properties": {
        "@type": { "type": "string", "const": "discovery", "readOnly": true },
        "versions": {
          "type": "array",
          "items": { "$ref": "#/$defs/discoveryVersion" },
          "minItems": 1,
          "readOnly": true
        },
        "environment": { "$ref": "#/$defs/discoveryEnvironment", "readOnly": true },
        "tlds": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "readOnly": true
        },
        "extensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/extension" },
          "readOnly": true
        },
        "profiles": {
          "type": "array",
          "items": { "type": "string" },
          "readOnly": true
        },
        "objects": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "readOnly": true
        },
        "datetime": { "type": "string", "format": "date-time", "readOnly": true },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "object": { "type": "string" }
            },
            "required": ["label", "object"]
          },
          "readOnly": true
        },
        "idnLgr": {
          "type": "array",
          "items": { "$ref": "#/$defs/discoveryIdnLgr" },
          "readOnly": true
        },
        "notices": {
          "type": "array",
          "items": { "$ref": "#/$defs/discoveryNotice" },
          "readOnly": true
        }
      },
      "required": ["@type", "versions", "environment", "tlds", "objects", "datetime"]
    }
  }
}
