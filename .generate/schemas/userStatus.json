{
  "$defs": {
    "userStatus": {
      "type": "object",
      "properties": {
        "@type": { "type": "string", "const": "userStatus" },
        "label": { "type": "string", "enum": ["active", "pending", "suspended", "deactivated"] },
        "reason": { "type": "string" }
      },
      "required": ["@type", "label"]
    }
  }
}
