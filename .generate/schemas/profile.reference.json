{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/profile.reference",
  "$defs": {
    "profile.reference": {
      "type": "object",
      "properties": {
        "@type": { "type": "string", "const": "profile" },
