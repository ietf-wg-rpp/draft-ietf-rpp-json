{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/message.reference",
  "$defs": {
    "message.reference": {
      "type": "object",
      "properties": {
        "@type": { "type": "string", "const": "message" },
        "id": { "$ref": "#/$defs/identifier", "readOnly": true }
      },
      "required": ["@type", "id"]
    }
  }
}
