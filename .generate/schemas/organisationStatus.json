{
  "$defs": {
    "organisationStatus": {
      "type": "object",
      "properties": {
        "@type": { "type": "string", "const": "organisationStatus" },
        "label": {
          "type": "string",
          "enum": [
            "ok",
            "hold",
            "terminated",
            "linked",
            "clientLinkProhibited",
            "serverLinkProhibited",
            "clientUpdateProhibited",
            "serverUpdateProhibited",
            "clientDeleteProhibited",
            "serverDeleteProhibited",
            "pendingCreate",
            "pendingUpdate",
            "pendingDelete"
          ]
        },
        "reason": { "type": "string" }
      },
      "required": ["@type", "label"]
    }
  }
}
