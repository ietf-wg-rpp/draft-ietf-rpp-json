{
  "$defs": {
    "period.create": {
      "type": "object",
      "properties": {
        "@type": { "type": "string", "const": "period" },
        "value": { "type": "integer", "minimum": 1, "maximum": 99 },
        "unit": { "type": "string", "enum": ["y", "m"] }
      },
      "required": ["@type", "value", "unit"]
    }
  }
}
