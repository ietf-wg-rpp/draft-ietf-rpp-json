{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/message.create",
  "$defs": {
    "message.create": {
      "type": "object",
      "properties": {
        "@type": { "type": "string", "const": "message" },
        "data": { "$dynamicRef": "#any.baseMessage.read", "writeOnly": true }
      },
      "required": ["@type", "data"]
    }
  }
}
